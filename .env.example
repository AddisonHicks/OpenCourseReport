VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Site URL for share links and OG tags (no trailing slash)
SITE_URL=https://open-course-report.vercel.app

# Optional: override OG image URLs (defaults to Supabase Storage share-og bucket)
# VITE_OG_IMAGE_HOME=
# VITE_OG_IMAGE_COURSE=
# VITE_OG_IMAGE_REPORT=
# OG_IMAGE_HOME=
# OG_IMAGE_COURSE=
# OG_IMAGE_REPORT=

# Server-side OG handler (Vercel). Falls back to VITE_* if unset.
SUPABASE_URL=
SUPABASE_ANON_KEY=
